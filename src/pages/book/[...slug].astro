---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allEntries = await getCollection('books');

  // Book entries have no slash in ID; chapter entries have bookId/chapterSlug
  const bookEntries = allEntries.filter(e => !e.id.includes('/'));
  const chapterEntries = allEntries.filter(e => e.id.includes('/'));

  const paths = [];

  for (const indexEntry of bookEntries) {
    const bookId = indexEntry.id;
    const chapters = chapterEntries
      .filter(e => e.id.startsWith(`${bookId}/`))
      .sort((a, b) => (a.data.chapter || 0) - (b.data.chapter || 0));

    // Book overview page
    paths.push({
      params: { slug: bookId },
      props: { entry: indexEntry, chapters, type: 'overview' as const },
    });

    // Individual chapter pages
    for (let i = 0; i < chapters.length; i++) {
      paths.push({
        params: { slug: chapters[i].id },
        props: {
          entry: chapters[i],
          bookEntry: indexEntry,
          chapters,
          currentIndex: i,
          type: 'chapter' as const,
        },
      });
    }
  }

  return paths;
}

const { entry, bookEntry, chapters = [], currentIndex = 0, type } = Astro.props;
const { Content } = await render(entry);

const prevChapter = type === 'chapter' && currentIndex > 0 ? chapters[currentIndex - 1] : null;
const nextChapter = type === 'chapter' && currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;

const bookId = entry.id.split('/')[0];

function chapterPath(ch: typeof chapters[0]): string {
  return `/book/${ch.id}`;
}
---

<BaseLayout
  title={type === 'overview' ? `${entry.data.title} — Thư Viện Của Mạnh` : `${entry.data.title} — ${bookEntry?.data.title}`}
  description={type === 'overview' ? entry.data.description : undefined}
>
  {type === 'overview' ? (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <nav class="text-sm text-ink-lighter dark:text-cream-300/50 mb-8">
        <a href="/" class="hover:text-forest-600 dark:hover:text-cream-200 transition-colors">Trang chủ</a>
        <span class="mx-2">&rsaquo;</span>
        <a href="/bookshelf" class="hover:text-forest-600 dark:hover:text-cream-200 transition-colors">Kệ sách</a>
        <span class="mx-2">&rsaquo;</span>
        <span class="text-ink dark:text-cream-200">{entry.data.title}</span>
      </nav>

      <div class="grid md:grid-cols-[240px_1fr] gap-8 sm:gap-12">
        <div class="mx-auto md:mx-0 w-60">
          <div class="aspect-[3/4] rounded-xl overflow-hidden shadow-lg bg-gradient-to-br from-forest-600 to-forest-800 flex flex-col items-center justify-center p-6 text-center">
            <svg class="w-12 h-12 text-white/60 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="font-serif text-white text-lg font-medium leading-tight">{entry.data.title}</span>
            <span class="text-white/50 text-sm mt-2">{entry.data.author}</span>
          </div>
        </div>

        <div>
          <span class="inline-block px-3 py-1 text-xs font-medium text-forest-600 dark:text-cream-300 bg-forest-600/10 dark:bg-cream-300/10 rounded-full mb-3">
            {entry.data.category}
          </span>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold text-ink dark:text-cream-100 mb-2">
            {entry.data.title}
          </h1>
          <p class="text-lg text-ink-light dark:text-cream-300/70 mb-4">
            {entry.data.author}
          </p>
          <p class="text-ink-light dark:text-cream-300/80 leading-relaxed mb-6">
            {entry.data.description}
          </p>

          <div class="flex flex-wrap gap-4 text-sm text-ink-lighter dark:text-cream-300/60 mb-8">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              {entry.data.totalChapters} chương
            </span>
            {entry.data.readingTime && (
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {entry.data.readingTime}
              </span>
            )}
          </div>

          <div>
            <h2 class="font-serif text-xl font-semibold text-ink dark:text-cream-100 mb-4">
              Mục lục
            </h2>
            <div class="space-y-2">
              {chapters.map((ch, i) => (
                <a
                  href={chapterPath(ch)}
                  class="flex items-center gap-3 p-3 rounded-lg hover:bg-cream-200 dark:hover:bg-[#333] transition-colors group"
                >
                  <span class="w-8 h-8 flex items-center justify-center rounded-full bg-cream-200 dark:bg-[#333] text-sm font-medium text-ink-light dark:text-cream-300 group-hover:bg-forest-600 group-hover:text-white transition-colors">
                    {i + 1}
                  </span>
                  <span class="text-ink dark:text-cream-200 group-hover:text-forest-600 dark:group-hover:text-cream-300 transition-colors">
                    {ch.data.title}
                  </span>
                </a>
              ))}
            </div>
          </div>

          {chapters.length > 0 && (
            <a href={chapterPath(chapters[0])} class="btn-primary mt-8">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              Bắt đầu đọc
            </a>
          )}
        </div>
      </div>
    </section>
  ) : (
    <article class="max-w-reading mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <nav class="text-sm text-ink-lighter dark:text-cream-300/50 mb-8">
        <a href="/" class="hover:text-forest-600 dark:hover:text-cream-200 transition-colors">Trang chủ</a>
        <span class="mx-2">&rsaquo;</span>
        <a href={`/book/${bookId}`} class="hover:text-forest-600 dark:hover:text-cream-200 transition-colors">{bookEntry?.data.title}</a>
        <span class="mx-2">&rsaquo;</span>
        <span class="text-ink dark:text-cream-200">{entry.data.title}</span>
      </nav>

      <header class="mb-10 pb-8 border-b border-cream-200 dark:border-[#333]">
        <p class="text-sm text-forest-600 dark:text-cream-300 font-medium mb-2">
          {bookEntry?.data.title}
        </p>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-cream-100">
          {entry.data.title}
        </h1>
      </header>

      <div class="prose-reading text-ink dark:text-cream-200">
        <Content />
      </div>

      <nav class="mt-16 pt-8 border-t border-cream-200 dark:border-[#333] grid grid-cols-2 gap-4">
        {prevChapter ? (
          <a href={chapterPath(prevChapter)} class="group flex flex-col p-4 rounded-lg hover:bg-cream-200 dark:hover:bg-[#333] transition-colors">
            <span class="text-xs text-ink-lighter dark:text-cream-300/50 mb-1">&larr; Chương trước</span>
            <span class="text-sm font-medium text-ink dark:text-cream-200 group-hover:text-forest-600 dark:group-hover:text-cream-300 transition-colors">
              {prevChapter.data.title}
            </span>
          </a>
        ) : (
          <a href={`/book/${bookId}`} class="group flex flex-col p-4 rounded-lg hover:bg-cream-200 dark:hover:bg-[#333] transition-colors">
            <span class="text-xs text-ink-lighter dark:text-cream-300/50 mb-1">&larr;</span>
            <span class="text-sm font-medium text-ink dark:text-cream-200 group-hover:text-forest-600 dark:group-hover:text-cream-300 transition-colors">
              Mục lục
            </span>
          </a>
        )}

        {nextChapter ? (
          <a href={chapterPath(nextChapter)} class="group flex flex-col items-end p-4 rounded-lg hover:bg-cream-200 dark:hover:bg-[#333] transition-colors text-right">
            <span class="text-xs text-ink-lighter dark:text-cream-300/50 mb-1">Chương tiếp &rarr;</span>
            <span class="text-sm font-medium text-ink dark:text-cream-200 group-hover:text-forest-600 dark:group-hover:text-cream-300 transition-colors">
              {nextChapter.data.title}
            </span>
          </a>
        ) : (
          <a href={`/book/${bookId}`} class="group flex flex-col items-end p-4 rounded-lg hover:bg-cream-200 dark:hover:bg-[#333] transition-colors text-right">
            <span class="text-xs text-ink-lighter dark:text-cream-300/50 mb-1">&rarr;</span>
            <span class="text-sm font-medium text-ink dark:text-cream-200 group-hover:text-forest-600 dark:group-hover:text-cream-300 transition-colors">
              Hoàn thành — Về mục lục
            </span>
          </a>
        )}
      </nav>
    </article>
  )}
</BaseLayout>
